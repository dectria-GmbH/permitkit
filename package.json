{
  "name": "permitkit",
  "version": "0.1.0",
  "description": "Authorization toolkit for TypeScript: roles, scopes, deny rules, dual approval and delegated agent access, as a pure and auditable decision function.",
  "author": "dectria GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dectria-GmbH/permitkit.git"
  },
  "homepage": "https://github.com/dectria-GmbH/permitkit#readme",
  "bugs": {
    "url": "https://github.com/dectria-GmbH/permitkit/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3.0"
  },
  "packageManager": "pnpm@12.21.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs/reference.md",
    "docs/database-enforcement.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=2",
    "smoke": "node scripts/smoke.mjs && node --experimental-vm-modules scripts/smoke-vm.mjs",
    "bundle-check": "node scripts/bundle-check.mjs",
    "consumer-types": "tsc -p test/consumer/tsconfig.json",
    "pack-check": "node scripts/pack-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm smoke && pnpm bundle-check && pnpm consumer-types && pnpm pack-check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.3",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
